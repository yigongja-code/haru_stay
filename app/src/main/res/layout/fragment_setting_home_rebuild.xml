<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background1"
    android:padding="16dp"
    tools:context=".ui.settingfragment.fragment_collect">

    <!-- 상단 '설정으로 돌아가기' 카드 박스 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_back_to_setting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="2dp"
        app:strokeColor="#2196F3"
        app:cardBackgroundColor="#F8FBFF"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_keyboard_double_arrow_left_24"
                android:contentDescription="돌아가기 아이콘" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="설정으로 돌아가기"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- [핵심 메인 카드 박스] 설정과 설명이 한눈에 들어오는 깔끔한 구조 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="2dp"
        app:strokeColor="#2196F3"
        app:cardBackgroundColor="#F8FBFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◼ 홈 화면 정보 카드 복구"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp" />


            <!-- 확인단추 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginBottom="16dp">


                <Button
                    android:id="@+id/btn_home_rebuild"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="재생성"
                    android:textSize="13sp"
                    android:backgroundTint="#4A88BF"
                    android:paddingHorizontal="14dp" />

            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D0E3F0"
                android:layout_marginBottom="16dp" />

            <!-- 상세 설명글 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 홈 화면의 정보 카드가 중복되거나 비정상적으로 늘어나거나 쪼개졌을때 사용합니다.\n• 현재 저장된 홈 정보 데이터를 기준으로 홈 화면의 체류 카드를 다시 구성합니다.\n• 일반적인 상황에는 사용할 필요가 없습니다.\n• 휴대폰 성능과 데이터의 크기에 따라 오래걸릴수 있습니다. "
                android:textSize="13sp"
                android:textColor="#555555"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

