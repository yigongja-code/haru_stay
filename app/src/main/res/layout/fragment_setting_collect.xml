<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background1"
    android:padding="16dp"
    tools:context=".ui.settingfragment.fragment_collect">

    <!-- 상단 '설정으로 돌아가기' 카드 박스 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_back_to_setting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="2dp"
        app:strokeColor="#2196F3"
        app:cardBackgroundColor="#F8FBFF"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_keyboard_double_arrow_left_24"
                android:contentDescription="돌아가기 아이콘" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="설정으로 돌아가기"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- [핵심 메인 카드 박스] 설정과 설명이 한눈에 들어오는 깔끔한 구조 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="2dp"
        app:strokeColor="#2196F3"
        app:cardBackgroundColor="#F8FBFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◼ 데이터 수집 간격 설정"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp" />

            <!-- 입력부: [앞에 안내 텍스트] + [중앙정렬 입력창] + [분] + [확인 버튼] -->
            <!-- 입력부: 양쪽으로 널찍하게 균형을 맞춘 구조 -->
            <!-- 입력부: 텍스트뷰의 가로 폭을 바짝 조이고 균형 있게 배치한 완성형 -->
            <!-- 입력부: '수집 주기' 텍스트 폭을 wrap_content로 강제 설정하여 간격 조절 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/edit_collect_interval"
                    android:layout_width="65dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="15"
                    android:inputType="number"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="분"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <Button
                    android:id="@+id/btn_save_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="확인"
                    android:textSize="13sp"
                    android:backgroundTint="#4A88BF"
                    android:paddingHorizontal="14dp" />



            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D0E3F0"
                android:layout_marginBottom="16dp" />

            <!-- 상세 설명글 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 짧은 간격으로 설정하면 GPS추적 앱처럼 많은 배터리 소모를 유발합니다. (최소 15분).\n\n•이 어플은 약간의 오차를 허용하면서 24시간 최소전력을 사용하여 작동되는걸 목표로 제작되었습니다.\n"
                android:textSize="13sp"
                android:textColor="#555555"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>